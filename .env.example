# Local web and API
API_PORT=4000
CLIENT_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-value

# MySQL. scripts/start_local.py provisions an isolated local instance on 3307.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=shuzhi_classroom

# Integrated lesson, PPT and Blender generation service
TEACHER_STUDIO_SERVICE_URL=http://127.0.0.1:8765
TEACHER_STUDIO_AUTOSTART=true
TEACHER_STUDIO_PYTHON=D:\jjr\.venv\Scripts\python.exe

# Hunyuan 3D generation. Image-to-3D is locked to this provider.
HUNYUAN3D_BASE_URL=https://tokenhub.tencentmaas.com
HUNYUAN3D_API_KEY=
HUNYUAN3D_MODEL=hy-3d-3.1
# Optional local lesson-language enhancement. The app falls back to built-in
# biomedical templates when Ollama or the configured model is unavailable.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
