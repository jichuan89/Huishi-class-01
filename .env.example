# Local web and API
API_PORT=4000
CLIENT_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-value

# MySQL. scripts/start_local.py provisions an isolated local instance on 3307.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=shuzhi_classroom

# Integrated lesson, PPT and Blender generation service
TEACHER_STUDIO_SERVICE_URL=http://127.0.0.1:8765
TEACHER_STUDIO_AUTOSTART=true
TEACHER_STUDIO_PYTHON=D:\jjr\.venv\Scripts\python.exe

# Optional Hunyuan/Tencent 3D generation
AI3D_SECRET_ID=
AI3D_SECRET_KEY=
AI3D_REGION=ap-guangzhou

# Optional external single/multiview reconstruction used by the prep studio
SF3D_BASE_URL=
SF3D_API_KEY=
SF3D_AUTH_TYPE=x-api-key
SF3D_MULTIVIEW_PATH=/v1/generate-multiview
